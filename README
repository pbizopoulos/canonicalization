# git+ssh://git@<domain>/<namespace>/<repository-name>			# <URL-private> remote private repository
# <domain>:<namespace>/<repository-name>				# <URL-public> remote public repository
# ~/<domain>/<namespace>/<repository-name>				# <URL-local> local repository
# Using a subset of https://numtide.github.io/blueprint/main/
# ~/<domain>/<namespace>/<repository-name>/packages/<package>		# <URL-local-package> https://numtide.github.io/blueprint/main/getting-started/folder_structure/#packages-for-packages
# ~/<domain>/<namespace>/<repository-name>/hosts/<host>			# <URL-local-host> https://numtide.github.io/blueprint/main/getting-started/folder_structure/#hostshostnamedefaultnixconfigurationnixdarwin-configurationnixsystem-configurationnixrpi-configurationnix
# ~/<domain>/<namespace>/<repository-name>/checks/<check>		# <URL-local-check> https://numtide.github.io/blueprint/main/getting-started/folder_structure/#checks-for-flake-checks
git clone <URL-*> <URL-local>						# clone repository
nix flake update <URL-*> 						# update flake lock file
nix flake check <URL-*>			 				# check whether the flake evaluates and run its tests
cd <URL-local> && nix fmt						# run formatter
cd <URL-local-package> && nix develop .#<package>			# enter <package> development environment
nix run <URL-*>#<package>						# run <package>; use the next command to run tests if the build is slow

name:          git-canonicalization
version:       0.0.0
synopsis:      Canonical repository checks and scaffolding CLI
description:
  Git porcelain for describing, checking, and scaffolding canonical repository packages and checks.
cabal-version: >=1.10
build-type:    Simple
executable git-canonicalization
  main-is:       Main.hs
  build-depends:
      aeson
    , base
    , bytestring
    , containers
    , data-fix
    , directory
    , filepath
    , hnix
    , HUnit
    , optparse-applicative
    , prettyprinter
    , process
    , regex-tdfa
    , text
    , unix
  ghc-options:   -O2 -Weverything -Werror -threaded

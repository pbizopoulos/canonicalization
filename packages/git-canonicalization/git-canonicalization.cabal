name:          git-canonicalization
version:       0.0.0
synopsis:      Canonical repository checks and scaffolding CLI
description:
  Git porcelain for describing, checking, and scaffolding canonical repository packages and checks.
cabal-version: >=1.10
build-type:    Simple
executable git-canonicalization
  main-is:       Main.hs
  build-depends:
      aeson
    , base
    , bytestring
    , Cabal-syntax
    , containers
    , data-fix
    , directory
    , filepath
    , haskell-src-exts
    , hnix
    , HUnit
    , network-uri
    , optparse-applicative
    , prettyprinter
    , process
    , regex-tdfa
    , syb
    , text
    , toml-reader
    , unix

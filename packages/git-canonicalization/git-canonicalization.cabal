name:          git-canonicalization
version:       0.0.0
synopsis:      Git wrapper for canonical home repository management
description:
  Git subcommand for initializing, adding repositories to, and checking the canonical home repository.
cabal-version: >=1.10
build-type:    Simple
executable git-canonicalization
  main-is:       Main.hs
  build-depends:
      base
    , directory
    , filepath
    , HUnit
    , process
    , text
    , unix
  ghc-options:   -O2 -Weverything -Werror -threaded

name:          nix-alphabetize
version:       0.0.0
synopsis:      Hello World Haskell
cabal-version: >=1.10
build-type:    Simple
executable nix-alphabetize
  main-is:       Main.hs
  build-depends:
      base
    , data-fix
    , hnix
    , HUnit
    , prettyprinter
    , QuickCheck
    , temporary
    , text
  ghc-options:   -O2 -Weverything -Werror -threaded
